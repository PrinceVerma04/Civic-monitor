<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.civicservices.monitor.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Capture flash: briefly turns white when a photo/auto-capture fires -->
    <View
        android:id="@+id/captureFlash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFFFF"
        android:alpha="0"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="18dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_round_button"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:tint="#FFFFFF"
        android:contentDescription="Back"
        android:padding="10dp" />

    <!-- Status pill: FPS + detection count -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_status_pill"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        tools:text="12.0 FPS  •  2 detections" />

    <ImageButton
        android:id="@+id/aboutButton"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_round_button"
        android:src="@android:drawable/ic_menu_info_details"
        app:tint="@color/brand_orange"
        android:contentDescription="About"
        android:padding="10dp" />

    <!-- Recording indicator -->
    <TextView
        android:id="@+id/recordingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="62dp"
        android:background="@drawable/bg_status_pill"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="● REC 00:00"
        android:textColor="@color/hazard_red"
        android:textStyle="bold"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Bottom control bar -->
    <LinearLayout
        android:id="@+id/controlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="36dp"
        android:paddingTop="16dp">

        <ImageButton
            android:id="@+id/captureButton"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="32dp"
            android:background="@drawable/bg_round_button"
            android:src="@android:drawable/ic_menu_camera"
            app:tint="#FFFFFF"
            android:contentDescription="Capture photo"
            android:padding="15dp" />

        <ImageButton
            android:id="@+id/recordButton"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:background="@drawable/bg_record_button"
            android:src="@android:drawable/presence_video_online"
            app:tint="#FFFFFF"
            android:contentDescription="Record video"
            android:padding="18dp" />
    </LinearLayout>

</FrameLayout>
